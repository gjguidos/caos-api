# General settings
APPLICATION_NAME=JOSHU-A
APPLICATION_OWNER="Development Team"
APPLICATION_OWNER_EMAIL=dev@example.com
ENVIRONMENT=Development
JOSHU_A_PUBLIC_KEY="IR#4080"
PORT=8001
LOG_LEVEL=INFO
LOG_SHOW_EXTRAS=false
LLM_PROVIDER=auto

#OPENAI API settings
OPENAI_API_KEY=<your-api-key>
OPENAI_URL=https://api.openai.com/v1

#Azure settings
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<your-client-id>
ENTRA_API_SCOPES=api://<your-client-id>/<scope-name>
ENTRA_ISSUER="https://sts.windows.net/<your-tenant-id>/"
ENTRA_JWKS_URL="https://login.microsoftonline.com/<your-tenant-id>/discovery/v2.0/keys"

# Azure OpenAI API settings
AZURE_OPENAI_ENDPOINT=<endpoint-url>
AZURE_OPENAI_API_KEY=<your-api-key>

AZURE_CHAT_DEPLOYMENTS=<your-chat-deployment>
AZURE_EMBEDDING_DEPLOYMENTS=<your-embedding-deployment>
AZURE_WHISPERING_DEPLOYMENTS=<your-whispering-deployment>
AZURE_IMAGE_DEPLOYMENTS=<your-image-deployment>
AZURE_VIDEO_DEPLOYMENTS=<your-video-deployment>
AZURE_IMAGE_DEFAULT_SIZE=<your-image-default-size>
DEFAULT_EMBEDDING_MODEL=<your-default-embedding-model>

# --- Optional model overrides ---
# You can override the default models for chat, image, embedding, and other tasks here.
# For example:
DEFAULT_CHAT_MODEL=gpt-6-astra
DEFAULT_IMAGE_MODEL=gpt-image-2.5-sunburst
DEFAULT_REALTIME_MODEL=gpt-realtime-2.1
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# DB settings
DB_URI=mongodb://mongo:27017
DB_NAME=agentverse_local

# Azure AI Search settings (for production vector storage)
# Development uses ChromaDB, production uses Azure Search
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=<your-admin-key>
AZURE_SEARCH_INDEX_PREFIX=agentverse
AZURE_SEARCH_VECTOR_DIMENSIONS=1536

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=api-template
REDIS_TLS=false
REDIS_URL=redis://:REPLACE_WITH_PRIVATE_REDIS_PASSWORD@redis:6379/0

## OPTIONAL SETTINGS ##

# User Management microservice (CAOS-user-management-api)
# Set AUTHZ_ENABLED=false to skip all permission checks (e.g. local dev without UMS)
AUTHZ_ENABLED=true
AUTHZ_URL=http://CAOS-user-management:8001/api
AUTHZ_CACHE_TTL=60
AUTHZ_TIMEOUT=10.0

# Orchestrator quality phases: analyze brief-shaping, refine and evaluate.
# Off by default: adds up to 3 LLM round-trips per turn without changing the reply.
# While off, run reports carry no evaluation block.
ORCHESTRATOR_QUALITY_PHASES_ENABLED=false


# Rate limiting settings
STANDARD_RATE_LIMIT=100
STANDARD_RATE_LIMIT_WINDOW=60
STRICT_RATE_LIMIT=20
STRICT_RATE_LIMIT_WINDOW=60
VERY_STRICT_RATE_LIMIT=5
VERY_STRICT_RATE_LIMIT_WINDOW=60
RATE_LIMIT_SUSPICIOUS_THRESHOLD=80
MONITOR_RATE_LIMITS=true

# MCP Proxy (agentverse-proxy) settings
# MCP_PROXY_TIMEOUT must stay above the proxy's own per-tool-server timeout
# (tool_servers/{env}.yaml) and below the chat turn cap of 190s.
MCP_PROXY_ENABLED=false
MCP_PROXY_BASE_URL=http://mcp-proxy:8080/api
MCP_PROXY_TIMEOUT=180.0

# Green Claim Analysis settings
GREEN_CLAIM_MODEL=gpt-5.2
GREEN_CLAIM_PROBLEMATIC_WORD_THRESHOLD=0.9
GREEN_CLAIM_CHUNK_SIZE=2500
GREEN_CLAIM_STATEMENT_SIMILARITY=0.85
GREEN_CLAIM_AUDIT_FULL_RESPONSE=false
# Genesis is opt-in; see docs/GENESIS_SESSION_INTEGRATION.md for local setup.
GENESIS_SESSIONS_ENABLED=false
# Optional absolute server-owned policy JSON; loading never provisions Redis tenants.
# GENESIS_SECURITY_POLICY_FILE=/run/config/genesis-security.json
# Default Compose requires a random >=64-character hex Redis password.
REDIS_PASSWORD=
REDIS_LOCAL_PORT=6380
GENESIS_LOCAL_ENABLED=false
# Local-only trusted policy: /app/config/genesis.local.json
